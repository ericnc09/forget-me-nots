{
  "name": "forget-me-nots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forget-me-nots Slack prototype and inherited Agents, Everywhere starter kit.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:slack": "npm run dev --workspace channel",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run verify:forgetme-nots",
    "dev:forgetme-nots": "npm --prefix apps/forgetme-nots run dev",
    "channel:forgetme-nots": "npm --prefix apps/forgetme-nots run channel",
    "verify:forgetme-nots": "npm --prefix apps/forgetme-nots run typecheck:channel && python3 -m py_compile apps/forgetme-nots/agents/orchestrator.py"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
