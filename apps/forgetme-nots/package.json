{
  "name": "forgetme-nots",
  "version": "0.1.0",
  "private": true,
  "description": "Managed Slack and web proof of concept using one Google ADK agent.",
  "scripts": {
    "dev": "npm run dev:infra && concurrently --names \"UI,Agent\" --prefix-colors \"cyan,gray\" \"npm run dev:ui\" \"npm run dev:orchestrator\"",
    "dev:ui": "next dev --turbopack",
    "dev:orchestrator": "agents/.venv/bin/python agents/orchestrator.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "channel": "tsx --tsconfig tsconfig.channel.json channel-host.mts",
    "typecheck:channel": "tsc -p tsconfig.channel.json --noEmit",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs",
    "smoke:agent": "node --import tsx scripts/smoke-agent.mts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/channels": "0.9.2",
    "@copilotkit/react-core": "1.70.2",
    "@copilotkit/runtime": "1.70.2",
    "dotenv": "^16.4.7",
    "hono": "^4",
    "lucide-react": "^0.577.0",
    "next": "15.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "postcss": "^8",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59"
  }
}
